# Canonical public URL of the storefront, WITHOUT a trailing slash.
# Used for canonical tags, Open Graph URLs, sitemap.xml, robots.txt and every
# JSON-LD @id. Inlined at BUILD time (NEXT_PUBLIC_*), so it must be set when
# `next build` runs — not just at runtime.
# Getting this wrong is worse than omitting it: it tells Google the real page
# lives at a URL that doesn't exist.
NEXT_PUBLIC_SITE_URL=https://cocojojochem.com

# Backend API base URL (includes the /api prefix).
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ---------------------------------------------------------------------------
# Payments — Stripe (https://dashboard.stripe.com/apikeys)
# Not connected yet. Needed once the checkout page's disabled card-entry
# mockup is replaced with real Stripe Elements (see TODO.md, "Payments").
# This is the publishable key (safe to expose client-side) — the secret key
# lives only in the backend's .env, never here.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
